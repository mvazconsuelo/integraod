# Copiá este archivo a .env (que NO se sube a git) y completalo.

# Clave de acceso a la app (mínimo 6 caracteres). Para el piloto puede ser corta; el login limita los intentos fallidos.
# Para producción usá una larga y al azar:  openssl rand -base64 24
ADMIN_TOKEN=

# Dirección pública que le vas a dar en Cloudflare (con https, sin barra al final).
PUBLIC_URL=https://app.tudominio.com

# Token del túnel (Cloudflare Zero Trust → Networks → Tunnels → tu túnel → Docker).
TUNNEL_TOKEN=

# true = pagos simulados (piloto). Con Mercado Pago real ver docs/docker-cloudflare.md.
MP_MOCK=true
