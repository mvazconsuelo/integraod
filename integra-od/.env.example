# integra-od/worker/.dev.vars en desarrollo; en producción: wrangler secret put <NOMBRE> -c worker/wrangler.toml
ADMIN_TOKEN=cambiar-por-una-clave-larga-y-aleatoria
APP_BASE_URL=http://localhost:8787
# PAYMENTS_URL=http://localhost:8788       # solo si se corre `dev:split`; normalmente se usa el binding "PAYMENTS", como en producción
# El id va en worker/wrangler.toml [vars] (PAYMENTS_CLIENT_ID). Las dos claves las imprime
# `npm run client -w payments -- create ...` (una sola vez); `npm run new-app` las genera solo en desarrollo.
SVC_SECRET_CORE=
SVC_SECRET_EVENTS=
