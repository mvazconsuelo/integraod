{
  "name": "payments",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 9231 --persist-to ../.dev-state",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply clinic-payments --local --persist-to ../.dev-state",
    "migrate:remote": "wrangler d1 migrations apply clinic-payments --remote",
    "typecheck": "tsc --noEmit",
    "client": "node scripts/client.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "wrangler": "^4.0.0"
  }
}
